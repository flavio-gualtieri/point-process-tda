# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Data: regenerated by the pipeline, never committed. A rerun into a fresh root (data_<tag>/) too.
/data/*
!/data/.gitkeep
/data_*/

# Run outputs. Everything a job writes is ignored, so no run can dirty the tree; the small
# summaries behind the paper (json / csv / md / yaml) are committed with `git add -f`.
results/
results_pre_split20k/
logs/
*.pt
*.joblib

# LaTeX build files (sources and the compiled pdf stay tracked)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.toc
paper/**/*.out

# Editors and OS
.vscode/
.DS_Store

\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Predicted versus true parameter values, ParamNet (DTM$_5$, persistence image) on the shared Thomas test split, one seed, both axes in log-normalized units (log-transform then z-score against the train split, the space $\mathcal  {L}$ is computed in); identity line dashed. The per-parameter difficulty ordering of Table~\ref {tab:perparam} is visible directly: a tight diagonal band for $\sigma $, a wider cloud for $\kappa $, and in both cases the residual is spread around the identity line rather than a systematic offset. Intuition-building rather than publication-rigorous: one trained seed, no error bars or per-point uncertainty.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:paramnet-scatter}{{4}{7}{Predicted versus true parameter values, ParamNet (DTM$_5$, persistence image) on the shared Thomas test split, one seed, both axes in log-normalized units (log-transform then z-score against the train split, the space $\mathcal {L}$ is computed in); identity line dashed. The per-parameter difficulty ordering of Table~\ref {tab:perparam} is visible directly: a tight diagonal band for $\sigma $, a wider cloud for $\kappa $, and in both cases the residual is spread around the identity line rather than a systematic offset. Intuition-building rather than publication-rigorous: one trained seed, no error bars or per-point uncertainty}{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Estimator comparison on Thomas and Nested Thomas, $n=10$ seeds, on the shared test split. $^{\ddagger }$ParamNet is process-specific: DTM$_5$ for Thomas, fused DTM$_{5,10,15}$ for nested Thomas. $^a$ Minimum contrast on $K$ is unstable across seeds rather than uniformly bad, and $^b$ minimum contrast on $g$ is consistently worse than chance; both are discussed in the text. $^{d}$Not run: no closed-form summary statistic for nested Thomas has yet been derived, so its absence is an outstanding experiment rather than an impossibility.}}{7}{table.caption.8}\protected@file@percent }
\newlabel{tab:classical-comparison}{{2}{7}{Estimator comparison on Thomas and Nested Thomas, $n=10$ seeds, on the shared test split. $^{\ddagger }$ParamNet is process-specific: DTM$_5$ for Thomas, fused DTM$_{5,10,15}$ for nested Thomas. $^a$ Minimum contrast on $K$ is unstable across seeds rather than uniformly bad, and $^b$ minimum contrast on $g$ is consistently worse than chance; both are discussed in the text. $^{d}$Not run: no closed-form summary statistic for nested Thomas has yet been derived, so its absence is an outstanding experiment rather than an impossibility}{table.caption.8}{}}

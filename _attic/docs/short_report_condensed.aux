\citation{diggle2003spatial}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Estimator comparison on Thomas and Nested Thomas, $n=10$ seeds, on the shared test split. $^{\ddagger }$ParamNet is process-specific: DTM$_5$ for Thomas, fused DTM$_{5,10,15}$ for nested Thomas. $^a$ Minimum contrast on $K$ is unstable across seeds rather than uniformly bad, and $^b$ minimum contrast on $g$ is consistently worse than chance; both are discussed in the text. $^{d}$Not run: no closed-form summary statistic for nested Thomas has yet been derived, so its absence is an outstanding experiment rather than an impossibility.}}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:classical-comparison}{{2}{6}{Estimator comparison on Thomas and Nested Thomas, $n=10$ seeds, on the shared test split. $^{\ddagger }$ParamNet is process-specific: DTM$_5$ for Thomas, fused DTM$_{5,10,15}$ for nested Thomas. $^a$ Minimum contrast on $K$ is unstable across seeds rather than uniformly bad, and $^b$ minimum contrast on $g$ is consistently worse than chance; both are discussed in the text. $^{d}$Not run: no closed-form summary statistic for nested Thomas has yet been derived, so its absence is an outstanding experiment rather than an impossibility}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Per-parameter loss $\mathcal  {L}^j$ underlying the aggregate $\mathcal  {L}$ of Table~\ref {tab:classical-comparison} (same methods, same seeds; ParamNet/nested is $n{=}3$). Minimum contrast has no nested-Thomas columns for the reason given there.}}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:perparam}{{3}{6}{Per-parameter loss $\mathcal {L}^j$ underlying the aggregate $\mathcal {L}$ of Table~\ref {tab:classical-comparison} (same methods, same seeds; ParamNet/nested is $n{=}3$). Minimum contrast has no nested-Thomas columns for the reason given there}{table.caption.6}{}}

\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces One point cloud $\rightarrow $ its $H_0/H_1$ persistence diagrams $\rightarrow $ the vectorizations compared in Table~\ref {tab:branches}: persistence-image raster, landscape stack, silhouette curve, Betti curve, and persistence-statistics summary. Top row: the tight-cluster design ($\kappa =50$, $\mu =4$, $\sigma =0.01$); bottom row: the near-Poisson design ($\kappa =4$, $\mu =5$, $\sigma =0.5$). Statistics-panel bars are min-max normalized per statistic, with raw values printed above each bar, since count, total persistence, and entropy live on incomparable scales.}}{5}{figure.caption.3}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:vectorization_schematic}{{1}{5}{One point cloud $\rightarrow $ its $H_0/H_1$ persistence diagrams $\rightarrow $ the vectorizations compared in Table~\ref {tab:branches}: persistence-image raster, landscape stack, silhouette curve, Betti curve, and persistence-statistics summary. Top row: the tight-cluster design ($\kappa =50$, $\mu =4$, $\sigma =0.01$); bottom row: the near-Poisson design ($\kappa =4$, $\mu =5$, $\sigma =0.5$). Statistics-panel bars are min-max normalized per statistic, with raw values printed above each bar, since count, total persistence, and entropy live on incomparable scales}{figure.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Branch summary: every axis measured against the multi-scale, $H_0{+}H_1$, CoordConv starting configuration, $n=10$ seeds per arm unless noted. Vectorization rows are the native-encoder path. A dagger ($^\dagger $) marks an arm on which at least one seed failed to converge and collapsed to the chance level, so the mean is dominated by the failed seed(s). $^{c}$$n=3$. The DTM$_5$ / fused rows support the process-specific scale choice rather than ablating a single model.}}{5}{table.caption.4}\protected@file@percent }
\newlabel{tab:branches}{{1}{5}{Branch summary: every axis measured against the multi-scale, $H_0{+}H_1$, CoordConv starting configuration, $n=10$ seeds per arm unless noted. Vectorization rows are the native-encoder path. A dagger ($^\dagger $) marks an arm on which at least one seed failed to converge and collapsed to the chance level, so the mean is dominated by the failed seed(s). $^{c}$$n=3$. The DTM$_5$ / fused rows support the process-specific scale choice rather than ablating a single model}{table.caption.4}{}}

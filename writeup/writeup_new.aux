\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Calibration sweep for the persistence-landscape (LS) vectorization, one-at-a-time around the native-budget default ($G=128$, $\tau =0.01$, $K$ data-derived), on the \emph  {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep} -- with two landscape channels per scale (six total). The diagram-grid coverage $q = 0.95$ (Section~\ref {ssec:calibration}) is fixed across every arm; $K$-selection uses coverage $c=0.99$ and cap $K_{\max }=16$, both fixed except in the third group. Cells report $\mathcal  {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds). $^\ddagger $ the $G=512$, $K=8$ arm matches the $4096$-d persistence-image budget of Table~\ref {tab:calibration-sweep} exactly; the other three rows of that group hold $G=128$ fixed and vary only $K$, so this row is not raster-size-matched to them.}}{24}{table.caption.22}\protected@file@percent }
\newlabel{tab:calibration-sweep-landscape}{{14}{24}{Calibration sweep for the persistence-landscape (LS) vectorization, one-at-a-time around the native-budget default ($G=128$, $\tau =0.01$, $K$ data-derived), on the \emph {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep} -- with two landscape channels per scale (six total). The diagram-grid coverage $q = 0.95$ (Section~\ref {ssec:calibration}) is fixed across every arm; $K$-selection uses coverage $c=0.99$ and cap $K_{\max }=16$, both fixed except in the third group. Cells report $\mathcal {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds). $^\ddagger $ the $G=512$, $K=8$ arm matches the $4096$-d persistence-image budget of Table~\ref {tab:calibration-sweep} exactly; the other three rows of that group hold $G=128$ fixed and vary only $K$, so this row is not raster-size-matched to them}{table.caption.22}{}}

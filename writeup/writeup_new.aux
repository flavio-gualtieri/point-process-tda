\newlabel{tab:classical-per-param}{{5}{17}{Per-parameter breakdown of Table~\ref {tab:classical-comparison}'s Thomas column ($n=10$ ParamNet, $n=5$ others). \texttt {vihrs} has the lowest loss in every column; see the discussion above for why this does not carry over to nested Thomas}{table.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Filtration comparison, Thomas process, persistence-image vectorization at the default calibration ($q=0.95$, Section~\ref {ssec:calibration}), $H_0{+}H_1$, shared-weight CoordConv architecture (Section~\ref {ssec:encoder-fusion}), $n=10$ seeds per row (Rips: $10$ attempted). $\mathcal  {L}^\kappa ,\mathcal  {L}^\mu ,\mathcal  {L}^\sigma $ are the per-parameter breakdown (parent intensity, offspring intensity, cluster scale respectively; Section~\ref {ssec:eval-protocol}). $^a$ Rips fails identically on $10/10$ seeds \emph  {before} training starts, not from a convergence failure: under Rips every $H_0$ feature is born at $r=0$, so the calibrated birth range collapses to a point and the calibration step raises rather than silently degrading -- exactly the degenerate-axis failure mode anticipated in Section~\ref {ssec:calibration}. No loss is produced for this row by construction, and no $DTM$ row shows a failed seed.}}{17}{table.caption.10}\protected@file@percent }
\newlabel{tab:filtration-comparison}{{6}{17}{Filtration comparison, Thomas process, persistence-image vectorization at the default calibration ($q=0.95$, Section~\ref {ssec:calibration}), $H_0{+}H_1$, shared-weight CoordConv architecture (Section~\ref {ssec:encoder-fusion}), $n=10$ seeds per row (Rips: $10$ attempted). $\mathcal {L}^\kappa ,\mathcal {L}^\mu ,\mathcal {L}^\sigma $ are the per-parameter breakdown (parent intensity, offspring intensity, cluster scale respectively; Section~\ref {ssec:eval-protocol}). $^a$ Rips fails identically on $10/10$ seeds \emph {before} training starts, not from a convergence failure: under Rips every $H_0$ feature is born at $r=0$, so the calibrated birth range collapses to a point and the calibration step raises rather than silently degrading -- exactly the degenerate-axis failure mode anticipated in Section~\ref {ssec:calibration}. No loss is produced for this row by construction, and no $DTM$ row shows a failed seed}{table.caption.10}{}}

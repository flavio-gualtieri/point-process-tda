\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Vectorization methods comparison: ``native'' denote's the methods' purpose-built encoder (CNN for PI/LS, 1-D CoordConv for SIL/BC); ``MLP'' is the architecture-agnostic \texttt  {FlattenMLPEncoder} applied to the same tensor. All native-path arms use the $q=0.95$ calibration matched to the persistence image rather than each vectorization's own tuned default from Appendix~\ref {app:alt-calibration}, so the comparison is calibration-fair, not each-vectorization-optimal; BC's own appendix-preferred $q=0.99$ scores slightly better ($0.179\pm 0.012$ T / $0.284\pm 0.011$ NT) but is not used here for consistency. T = Thomas, NT = nested-Thomas; seed count $n$ in parentheses (PI native/T uses the 10-seed default run, all other cells use 3--5 seeds -- see Section~\ref {ssec:encoder-fusion} for the shared training protocol). Per-channel dim $\times $ channels gives the flattened tensor size actually fed to the encoder (PI: $24{,}576$; LS: $12{,}288$; SIL: $1{,}536$; BC: $768$) -- comparisons above are not capacity-matched.}}{18}{table.6}\protected@file@percent }
\newlabel{tab:main-comparison}{{6}{18}{Vectorization methods comparison: ``native'' denote's the methods' purpose-built encoder (CNN for PI/LS, 1-D CoordConv for SIL/BC); ``MLP'' is the architecture-agnostic \texttt {FlattenMLPEncoder} applied to the same tensor. All native-path arms use the $q=0.95$ calibration matched to the persistence image rather than each vectorization's own tuned default from Appendix~\ref {app:alt-calibration}, so the comparison is calibration-fair, not each-vectorization-optimal; BC's own appendix-preferred $q=0.99$ scores slightly better ($0.179\pm 0.012$ T / $0.284\pm 0.011$ NT) but is not used here for consistency. T = Thomas, NT = nested-Thomas; seed count $n$ in parentheses (PI native/T uses the 10-seed default run, all other cells use 3--5 seeds -- see Section~\ref {ssec:encoder-fusion} for the shared training protocol). Per-channel dim $\times $ channels gives the flattened tensor size actually fed to the encoder (PI: $24{,}576$; LS: $12{,}288$; SIL: $1{,}536$; BC: $768$) -- comparisons above are not capacity-matched}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Homology-dimension ablation (C3), $n=5$ seeds per arm, both design distributions. Only the PI arm has been run so far; LS and BC rows are pending. \#\#\# = not yet run.}}{19}{table.7}\protected@file@percent }

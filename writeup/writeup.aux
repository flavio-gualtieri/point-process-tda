\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Calibration sweep for the persistence-landscape (LS) vectorization, one-at-a-time around the native-budget default ($G=128$, $\tau =0.01$, $K$ data-derived), on the \emph  {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep} -- with two landscape channels per scale (six total). The diagram-grid coverage $q = 0.95$ (Section~\ref {ssec:calibration}) is fixed across every arm; $K$-selection uses coverage $c=0.99$ and cap $K_{\max }=16$, both fixed except in the third group. Cells report $\mathcal  {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds). $^\ddagger $ the $G=512$, $K=8$ arm matches the $4096$-d persistence-image budget of Table~\ref {tab:calibration-sweep} exactly; the other three rows of that group hold $G=128$ fixed and vary only $K$, so this row is not raster-size-matched to them.}}{23}{table.caption.27}\protected@file@percent }
\newlabel{tab:calibration-sweep-landscape}{{10}{23}{Calibration sweep for the persistence-landscape (LS) vectorization, one-at-a-time around the native-budget default ($G=128$, $\tau =0.01$, $K$ data-derived), on the \emph {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep} -- with two landscape channels per scale (six total). The diagram-grid coverage $q = 0.95$ (Section~\ref {ssec:calibration}) is fixed across every arm; $K$-selection uses coverage $c=0.99$ and cap $K_{\max }=16$, both fixed except in the third group. Cells report $\mathcal {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds). $^\ddagger $ the $G=512$, $K=8$ arm matches the $4096$-d persistence-image budget of Table~\ref {tab:calibration-sweep} exactly; the other three rows of that group hold $G=128$ fixed and vary only $K$, so this row is not raster-size-matched to them}{table.caption.27}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Grid-resolution calibration sweep for the silhouette (SIL-1, $p=1$) vectorization, on the \emph  {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep}. The diagram-grid coverage $q=0.95$ and padding $\alpha =1.05$ (Section~\ref {ssec:calibration}) are fixed across every arm at the values selected for the persistence image. Cells report $\mathcal  {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds).}}{23}{table.caption.28}\protected@file@percent }
\newlabel{tab:calibration-sweep-silhouette}{{11}{23}{Grid-resolution calibration sweep for the silhouette (SIL-1, $p=1$) vectorization, on the \emph {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep}. The diagram-grid coverage $q=0.95$ and padding $\alpha =1.05$ (Section~\ref {ssec:calibration}) are fixed across every arm at the values selected for the persistence image. Cells report $\mathcal {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds)}{table.caption.28}{}}

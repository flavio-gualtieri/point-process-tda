\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Naive pooled min/max calibration (left) versus per-diagram coverage-quantile calibration, $q=0.95$, $\alpha =1.05$ (right), for the same $H_0$ diagram (DTM filtration, $k=5$, Thomas design distribution, Section~\ref {sec:simulator}). Top: the diagram against its calibrated birth-persistence box; the naive box is stretched by an outlier diagram elsewhere in the population, and the dashed square marks the region zoomed into below. Bottom: that region at each calibration's native pixel density -- a $7\times 7$ block of mostly-fused pixels under the naive bound versus a $16\times 16$ grid resolving the secondary peak under the quantile bound, since the same $64\times 64$ grid now covers a narrower range.}}{13}{figure.caption.3}\protected@file@percent }
\newlabel{fig:calibration_comparison}{{2}{13}{Naive pooled min/max calibration (left) versus per-diagram coverage-quantile calibration, $q=0.95$, $\alpha =1.05$ (right), for the same $H_0$ diagram (DTM filtration, $k=5$, Thomas design distribution, Section~\ref {sec:simulator}). Top: the diagram against its calibrated birth-persistence box; the naive box is stretched by an outlier diagram elsewhere in the population, and the dashed square marks the region zoomed into below. Bottom: that region at each calibration's native pixel density -- a $7\times 7$ block of mostly-fused pixels under the naive bound versus a $16\times 16$ grid resolving the secondary peak under the quantile bound, since the same $64\times 64$ grid now covers a narrower range}{figure.caption.3}{}}

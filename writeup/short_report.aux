\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Estimator comparison, both design distributions, $n=10$ seeds (ParamNet) or $n=5$ seeds (vihrs, minimum contrast) on the shared test split of Section~\ref {ssec:eval}. Minimum contrast has no nested-Thomas entry because the process has no closed-form $K$ or $g$ to fit against, here making the comparison itself impossible rather than merely inconvenient. $^a$ Minimum contrast on $K$ is unstable across seeds rather than uniformly bad: 3/5 seeds land at $0.379$--$0.399$, close to vihrs, while 2/5 land far worse ($0.903$ and $2.056$). $^b$ Minimum contrast on $g$ is, in contrast, consistently worse than chance on $5/5$ seeds -- a systematic bias rather than scattered non-convergence. Its contrast exponent $c=1$ is set by analogy with \citet  {diggle2003spatial}'s $K$-based rule of thumb rather than tuned; we report the number rather than suppress it, but do not read it as a settled statement about contrast estimation on $g$ in general.}}{7}{table.caption.7}\protected@file@percent }
\newlabel{tab:classical-comparison}{{2}{7}{Estimator comparison, both design distributions, $n=10$ seeds (ParamNet) or $n=5$ seeds (vihrs, minimum contrast) on the shared test split of Section~\ref {ssec:eval}. Minimum contrast has no nested-Thomas entry because the process has no closed-form $K$ or $g$ to fit against, here making the comparison itself impossible rather than merely inconvenient. $^a$ Minimum contrast on $K$ is unstable across seeds rather than uniformly bad: 3/5 seeds land at $0.379$--$0.399$, close to vihrs, while 2/5 land far worse ($0.903$ and $2.056$). $^b$ Minimum contrast on $g$ is, in contrast, consistently worse than chance on $5/5$ seeds -- a systematic bias rather than scattered non-convergence. Its contrast exponent $c=1$ is set by analogy with \citet {diggle2003spatial}'s $K$-based rule of thumb rather than tuned; we report the number rather than suppress it, but do not read it as a settled statement about contrast estimation on $g$ in general}{table.caption.7}{}}

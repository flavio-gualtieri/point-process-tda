\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One point cloud $\rightarrow $ its $H_0/H_1$ persistence diagrams $\rightarrow $ the vectorizations compared in Table~\ref {tab:branches}: persistence-image raster, landscape stack, silhouette curve, Betti curve, and persistence-statistics summary. Top row: the tight-cluster design ($\kappa =50$, $\mu =4$, $\sigma =0.01$); bottom row: the near-Poisson design ($\kappa =4$, $\mu =5$, $\sigma =0.5$). Statistics-panel bars are min-max normalized per statistic, with raw values printed above each bar, since count, total persistence, and entropy live on incomparable scales.}}{10}{figure.caption.8}\protected@file@percent }

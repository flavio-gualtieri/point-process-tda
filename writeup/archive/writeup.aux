\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Vectorization methods comparison. ``Native'' denotes the methods' purpose-built encoder (CNN for PI/LS, 1-D CoordConv for SIL/BC); ``MLP'' is the architecture-agnostic \texttt  {FlattenMLPEncoder} applied to the same tensor. All native-path arms use the $q=0.95$ calibration matched to the persistence image rather than each vectorization's own tuned default from Appendix~\ref {app:alt-calibration}, so the comparison is calibration-fair; BC's own appendix-preferred $q=0.99$ scores slightly better ($0.179\pm 0.012$ T / $0.284\pm 0.011$ NT) but is not used here for consistency. SIL is fixed at $p=1$ throughout (the SIL-1 arm of Appendix~\ref {app:calib-silhouette}) for both the native and MLP path. T = Thomas, NT = nested-Thomas; seed count $n$ in parentheses.}}{20}{table.caption.16}\protected@file@percent }
\newlabel{tab:main-comparison}{{9}{20}{Vectorization methods comparison. ``Native'' denotes the methods' purpose-built encoder (CNN for PI/LS, 1-D CoordConv for SIL/BC); ``MLP'' is the architecture-agnostic \texttt {FlattenMLPEncoder} applied to the same tensor. All native-path arms use the $q=0.95$ calibration matched to the persistence image rather than each vectorization's own tuned default from Appendix~\ref {app:alt-calibration}, so the comparison is calibration-fair; BC's own appendix-preferred $q=0.99$ scores slightly better ($0.179\pm 0.012$ T / $0.284\pm 0.011$ NT) but is not used here for consistency. SIL is fixed at $p=1$ throughout (the SIL-1 arm of Appendix~\ref {app:calib-silhouette}) for both the native and MLP path. T = Thomas, NT = nested-Thomas; seed count $n$ in parentheses}{table.caption.16}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Homology-dimension ablation (C3), $n=5$ seeds per arm, both design distributions, native encoder path at the shared $q=0.95$ calibration (Section~\ref {ssec:calibration}) rather than each vectorization's own appendix-preferred default. PI and BC are complete; LS's $H_1$-only arm has not been run (\#\#\# = not yet run) -- LS's $H_0{+}H_1$ default is the native row of Table~\ref {tab:main-comparison} ($0.132\pm 0.008$ T / $0.250\pm 0.005$ NT, 3 seeds), not repeated here since it was not re-run at $n=5$.}}{20}{table.caption.17}\protected@file@percent }
\newlabel{tab:homology-ablation}{{10}{20}{Homology-dimension ablation (C3), $n=5$ seeds per arm, both design distributions, native encoder path at the shared $q=0.95$ calibration (Section~\ref {ssec:calibration}) rather than each vectorization's own appendix-preferred default. PI and BC are complete; LS's $H_1$-only arm has not been run (\#\#\# = not yet run) -- LS's $H_0{+}H_1$ default is the native row of Table~\ref {tab:main-comparison} ($0.132\pm 0.008$ T / $0.250\pm 0.005$ NT, 3 seeds), not repeated here since it was not re-run at $n=5$}{table.caption.17}{}}

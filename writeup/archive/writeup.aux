\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Calibration sweep for the persistence-landscape (LS) vectorization, one-at-a-time around the native-budget default ($G=128$, $\tau =0.01$, $K$ data-derived), on the \emph  {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep} -- with two landscape channels per scale (six total). The diagram-grid coverage $q = 0.95$ (Section~\ref {ssec:calibration}) is fixed across every arm; $K$-selection uses coverage $c=0.99$ and cap $K_{\max }=16$, both fixed except in the third group. Cells report $\mathcal  {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds). $^\ddagger $ the $G=512$, $K=8$ arm matches the $4096$-d persistence-image budget of Table~\ref {tab:calibration-sweep} exactly; the other three rows of that group hold $G=128$ fixed and vary only $K$, so this row is not raster-size-matched to them.}}{26}{table.caption.31}\protected@file@percent }
\newlabel{tab:calibration-sweep-landscape}{{14}{26}{Calibration sweep for the persistence-landscape (LS) vectorization, one-at-a-time around the native-budget default ($G=128$, $\tau =0.01$, $K$ data-derived), on the \emph {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep} -- with two landscape channels per scale (six total). The diagram-grid coverage $q = 0.95$ (Section~\ref {ssec:calibration}) is fixed across every arm; $K$-selection uses coverage $c=0.99$ and cap $K_{\max }=16$, both fixed except in the third group. Cells report $\mathcal {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds). $^\ddagger $ the $G=512$, $K=8$ arm matches the $4096$-d persistence-image budget of Table~\ref {tab:calibration-sweep} exactly; the other three rows of that group hold $G=128$ fixed and vary only $K$, so this row is not raster-size-matched to them}{table.caption.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Grid-resolution calibration sweep for the silhouette (SIL-1, $p=1$) vectorization, on the \emph  {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep}. The diagram-grid coverage $q=0.95$ and padding $\alpha =1.05$ (Section~\ref {ssec:calibration}) are fixed across every arm at the values selected for the persistence image. Cells report $\mathcal  {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds).}}{26}{table.caption.32}\protected@file@percent }
\newlabel{tab:calibration-sweep-silhouette}{{15}{26}{Grid-resolution calibration sweep for the silhouette (SIL-1, $p=1$) vectorization, on the \emph {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline and shared-weight architecture of Section~\ref {ssec:encoder-fusion} -- the same one used for the persistence-image sweep of Table~\ref {tab:calibration-sweep}. The diagram-grid coverage $q=0.95$ and padding $\alpha =1.05$ (Section~\ref {ssec:calibration}) are fixed across every arm at the values selected for the persistence image. Cells report $\mathcal {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds)}{table.caption.32}{}}
\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces Calibration sweep for the Betti-curve (BC) vectorization, one-at-a-time around the native-budget default (grid\_size $=128$, $q=0.95$), on the \emph  {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline (Euler channel disabled, see text) and shared-weight architecture of Section~\ref {ssec:encoder-fusion}. Padding is fixed at $\alpha =1.05$ throughout -- the value selected for the persistence image -- rather than this vectorization's own code default of $\alpha =1.1$. Cells report $\mathcal  {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds).}}{27}{table.caption.33}\protected@file@percent }
\newlabel{tab:calibration-sweep-betti}{{16}{27}{Calibration sweep for the Betti-curve (BC) vectorization, one-at-a-time around the native-budget default (grid\_size $=128$, $q=0.95$), on the \emph {params} task for both the Thomas and nested-Thomas design distributions (Section~\ref {sec:simulator}). Diagrams use the default $DTM_{\{5,10,15\}}$, $H_0{+}H_1$ pipeline (Euler channel disabled, see text) and shared-weight architecture of Section~\ref {ssec:encoder-fusion}. Padding is fixed at $\alpha =1.05$ throughout -- the value selected for the persistence image -- rather than this vectorization's own code default of $\alpha =1.1$. Cells report $\mathcal {L}$ (Section~\ref {ssec:eval-protocol}, mean $\pm $ sd over 3 seeds)}{table.caption.33}{}}

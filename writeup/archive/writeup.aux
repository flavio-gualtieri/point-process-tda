\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Filtration comparison, Thomas process, persistence-image vectorization at the default calibration ($q=0.95$, Section~\ref {ssec:calibration}), $H_0{+}H_1$, shared-weight CoordConv architecture (Section~\ref {ssec:encoder-fusion}), $n=10$ seeds per row (Rips: $10$ attempted). $\mathcal  {L}^\kappa ,\mathcal  {L}^\mu ,\mathcal  {L}^\sigma $ are the per-parameter breakdown (parent intensity, offspring intensity, cluster scale respectively; Section~\ref {ssec:eval-protocol}). $^a$ Rips fails identically on $10/10$ seeds \emph  {before} training starts, not from a convergence failure: under Rips every $H_0$ feature is born at $r=0$, so the calibrated birth range collapses to a point and the calibration step raises rather than silently degrading -- exactly the degenerate-axis failure mode anticipated in Section~\ref {ssec:calibration}. No loss is produced for this row by construction, and no $DTM_k$ row shows a failed seed.}}{12}{table.caption.3}\protected@file@percent }
\newlabel{tab:filtration-comparison}{{2}{12}{Filtration comparison, Thomas process, persistence-image vectorization at the default calibration ($q=0.95$, Section~\ref {ssec:calibration}), $H_0{+}H_1$, shared-weight CoordConv architecture (Section~\ref {ssec:encoder-fusion}), $n=10$ seeds per row (Rips: $10$ attempted). $\mathcal {L}^\kappa ,\mathcal {L}^\mu ,\mathcal {L}^\sigma $ are the per-parameter breakdown (parent intensity, offspring intensity, cluster scale respectively; Section~\ref {ssec:eval-protocol}). $^a$ Rips fails identically on $10/10$ seeds \emph {before} training starts, not from a convergence failure: under Rips every $H_0$ feature is born at $r=0$, so the calibrated birth range collapses to a point and the calibration step raises rather than silently degrading -- exactly the degenerate-axis failure mode anticipated in Section~\ref {ssec:calibration}. No loss is produced for this row by construction, and no $DTM_k$ row shows a failed seed}{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Table~\ref {tab:filtration-comparison}'s comparison repeated for both design distributions, scalar $\mathcal  {L}$ only -- nested Thomas's five targets do not share Thomas's $\kappa ,\mu ,\sigma $ decomposition. $n=10$ seeds per row, except nested-Thomas's DTM$_{\{5,10,15\}}$ row, which reuses the $n=5$ \texttt  {confirm\_shared\_concat} run already reported as the PI/native entry of Table~\ref {tab:main-comparison} and the shared-encoder row of Table~\ref {tab:encoder-confirm}, rather than a separately-seeded run. $^a$ Rips fails identically on both design distributions, $10/10$ seeds each, for the reason given in Table~\ref {tab:filtration-comparison}'s caption.}}{12}{table.caption.4}\protected@file@percent }
\newlabel{tab:filtration-comparison-nt}{{3}{12}{Table~\ref {tab:filtration-comparison}'s comparison repeated for both design distributions, scalar $\mathcal {L}$ only -- nested Thomas's five targets do not share Thomas's $\kappa ,\mu ,\sigma $ decomposition. $n=10$ seeds per row, except nested-Thomas's DTM$_{\{5,10,15\}}$ row, which reuses the $n=5$ \texttt {confirm\_shared\_concat} run already reported as the PI/native entry of Table~\ref {tab:main-comparison} and the shared-encoder row of Table~\ref {tab:encoder-confirm}, rather than a separately-seeded run. $^a$ Rips fails identically on both design distributions, $10/10$ seeds each, for the reason given in Table~\ref {tab:filtration-comparison}'s caption}{table.caption.4}{}}
